{
  "id": "volume_price",
  "name": "量价关系策略",
  "version": "1.0.0",
  "author": "AStock Quant Engine",
  "description": "基于量价理论的综合策略，包含量价齐升、缩量下跌后放量反转、OBV 金叉等信号",
  "category": "volume_price",
  "tags": ["量价", "成交量", "OBV", "突破"],
  "parameters": {
    "volume_ma_period": {
      "type": "int",
      "default": 20,
      "min": 5,
      "max": 60,
      "description": "成交量均线周期"
    },
    "volume_surge_ratio": {
      "type": "float",
      "default": 1.5,
      "min": 1.2,
      "max": 3.0,
      "description": "放量倍数阈值"
    },
    "volume_shrink_ratio": {
      "type": "float",
      "default": 0.7,
      "min": 0.3,
      "max": 0.9,
      "description": "缩量倍数阈值"
    },
    "price_ma_short": {
      "type": "int",
      "default": 5,
      "min": 3,
      "max": 20,
      "description": "短期价格均线周期"
    },
    "price_ma_long": {
      "type": "int",
      "default": 20,
      "min": 10,
      "max": 120,
      "description": "长期价格均线周期"
    },
    "obv_signal_period": {
      "type": "int",
      "default": 10,
      "min": 5,
      "max": 30,
      "description": "OBV 信号线周期"
    },
    "min_price_change": {
      "type": "float",
      "default": 0.01,
      "min": 0.002,
      "max": 0.05,
      "description": "最小价格变动阈值 (比例)"
    },
    "mode": {
      "type": "enum",
      "default": "balanced",
      "options": ["conservative", "balanced", "aggressive"],
      "description": "策略风格模式"
    },
    "t_mode": {
      "type": "enum",
      "default": "NONE",
      "options": ["NONE", "T0", "T1", "T0_T1"],
      "description": "T 交易模式: T0 日内回转 / T1 隔日回转 / T0_T1 组合"
    }
  },
  "dependencies": ["numpy", "pandas"],
  "enabled": true,
  "min_bars": 60,
  "created_at": "2026-01-31T12:00:00",
  "updated_at": "2026-01-31T12:00:00"
}
